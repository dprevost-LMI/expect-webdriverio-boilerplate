{
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["node", "webdriverio", "@wdio/mocha-framework", "expect-webdriverio"],
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
